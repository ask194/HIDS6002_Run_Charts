#| label: setup
#| message: false
library(readr)
library(dplyr)
library(lubridate)
library(qicharts2)
#| label: load-data
#| message: false
encounters <- read_csv("data/encounters.csv")
#| label: load-data
#| message: false
encounters <- read_csv("../Data/encounters.csv")
#| label: load-data
#| message: false
encounters <- read_csv(".../Data/encounters.csv")
#| label: load-data
#| message: false
encounters <- read_csv("./Data/encounters.csv")
#| label: load-data
#| message: false
encounters <- read_csv("../Data/encounters.csv")
#| label: load-data
#| message: false
encounters <- read_csv("../HIDS6002_Run_Charts/Data/encounters.csv")
labs <- read_csv("data/labs.csv")
#| label: load-data
#| message: false
encounters <- read_csv("../HIDS6002_Run_Charts/Data/encounters.csv")
labs <- read_csv("../HIDS6002_Run_Charts/labs.csv")
#| label: load-data
#| message: false
encounters <- read_csv("../HIDS6002_Run_Charts/Data/encounters.csv")
labs <- read_csv("../HIDS6002_Run_Charts/Data/labs.csv")
lookup <- read_csv("../HIDS6002_Run_Charts/Data/provider_lookup.csv")
#| label: parse-dates
parse_mixed_date <- function(x) {
d_iso <- suppressWarnings(as.Date(x, format = "%Y-%m-%d"))
d_us  <- suppressWarnings(as.Date(x, format = "%m/%d/%Y"))
coalesce(d_iso, d_us)
}
encounters <- encounters %>% mutate(encounter_date = parse_mixed_date(encounter_date))
labs <- labs %>% mutate(result_date = parse_mixed_date(result_date))
#| label: naive-join-check
naive <- encounters %>% left_join(lookup, by = "provider_id")
sum(is.na(naive$clinic_id))
sort(unique(naive$provider_id[is.na(naive$clinic_id)]))[1:6]
#| label: standardized-join
standardize <- function(x) toupper(trimws(x))
encounters <- encounters %>% mutate(provider_id_std = standardize(provider_id))
lookup_std <- lookup %>% mutate(provider_id_std = standardize(provider_id))
encounters <- encounters %>%
select(-any_of("clinic_id")) %>%
left_join(lookup_std %>% select(provider_id_std, clinic_id), by = "provider_id_std")
sum(is.na(encounters$clinic_id))
#| label: denominator
denom <- encounters %>%
filter(clinic_id %in% c("Clinic B", "Clinic D")) %>%
mutate(month = floor_date(encounter_date, "month")) %>%
distinct(clinic_id, month, patient_id) %>%
count(clinic_id, month, name = "denominator")
#| label: clean-labs
labs_numeric <- labs %>%
filter(test_name == "HbA1c") %>%
distinct(patient_id, result_date, test_name, result_value) %>%
mutate(result_value = suppressWarnings(as.numeric(result_value))) %>%
filter(!is.na(result_value))
n_before_range <- nrow(labs_numeric)
labs_clean <- labs_numeric %>%
filter(result_value >= 4, result_value <= 15) %>%
mutate(month = floor_date(result_date, "month"))
n_before_range - nrow(labs_clean)
#| label: numerator-and-assemble
patient_clinic_month <- encounters %>%
filter(clinic_id %in% c("Clinic B", "Clinic D")) %>%
mutate(month = floor_date(encounter_date, "month")) %>%
distinct(clinic_id, month, patient_id)
numer <- labs_clean %>%
filter(result_value < 8) %>%
inner_join(patient_clinic_month, by = c("patient_id", "month")) %>%
distinct(clinic_id, month, patient_id) %>%
count(clinic_id, month, name = "numerator")
measure <- denom %>%
left_join(numer, by = c("clinic_id", "month"))
#| label: chart-b
q_b <- qic(
x = month, y = numerator, n = denominator,
data = measure %>% filter(clinic_id == "Clinic B") %>% arrange(month),
chart = "p", title = "Clinic B"
)
q_b
any(q_b$data$sigma.signal, na.rm = TRUE)
any(q_b$data$runs.signal, na.rm = TRUE)
#| label: chart-d
q_d <- qic(
x = month, y = numerator, n = denominator,
data = measure %>% filter(clinic_id == "Clinic D") %>% arrange(month),
chart = "p", title = "Clinic D"
)
q_d
any(q_d$data$sigma.signal, na.rm = TRUE)
any(q_d$data$runs.signal, na.rm = TRUE)
?qic
